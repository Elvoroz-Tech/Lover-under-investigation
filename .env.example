# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env` (or `.env.local`) and fill it in.
#  Every variable is optional — the app runs with sensible defaults.
# ─────────────────────────────────────────────────────────────

# The project / brand name. Change it here and it changes EVERYWHERE
# (navbar, certificates, share text, page titles, OG images, legal pages).
NEXT_PUBLIC_APP_NAME="Lover Under Investigation"

# Short tagline used in metadata and the footer.
NEXT_PUBLIC_APP_TAGLINE="A relationship roast disguised as an official investigation."

# Public URL of the site, no trailing slash. Used for share links & OG images.
# In development this can stay as localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shown on the Contact / Privacy / Opt-out pages.
NEXT_PUBLIC_CONTACT_EMAIL="contact@woopi.world"

# The company that builds & operates the product (footer, Contact, Terms, metadata).
NEXT_PUBLIC_COMPANY_NAME="Elvoroz"
NEXT_PUBLIC_COMPANY_EMAIL="contact@elvoroz.com"

# ── Rate limiting (per IP, sliding window of RATE_LIMIT_WINDOW_SECONDS) ──
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PAGES_MAX=120
RATE_LIMIT_OG_MAX=40
RATE_LIMIT_API_MAX=30

# Secret salt used to hash IP addresses before they are counted.
# Raw IPs are never stored anywhere. Use any long random string.
RATE_LIMIT_SALT="change-me-to-a-long-random-string"

# ── OPTIONAL: MongoDB ──
# Leave empty to use the built-in in-memory limiter (fine for a single server).
# Set it when you deploy to multiple instances / serverless so limits are shared.
# MongoDB only ever stores { hashed-ip+bucket, counter, expiry } — no cases, no names.
MONGODB_URI=""
MONGODB_DB_NAME="lover_under_investigation"

# ── Abuse takedowns ──
# Comma-separated case codes (the part after /case/) that should never render.
BLOCKED_CASE_CODES=""

# ── OPTIONAL: Google Search Console ──
# Paste ONLY the content value of the verification meta tag
# (<meta name="google-site-verification" content="THIS_PART">). Leave empty to disable.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ── OPTIONAL: Bing Webmaster Tools ── (content value of msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# ── OPTIONAL: Google Analytics 4 ──
# Your Measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable (no GA code is loaded at all).
# Case links are automatically redacted to /case/[redacted] before anything is sent to Google.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
